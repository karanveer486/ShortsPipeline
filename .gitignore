# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
oauth*.json
token*.json

# Editor and operating-system files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Runtime workspace: source media, intermediate artifacts, models, and outputs
workspace/*
!workspace/.gitkeep
!workspace/inbox/
!workspace/inbox/.gitkeep
!workspace/metadata/
!workspace/metadata/.gitkeep
!workspace/transcripts/
!workspace/transcripts/.gitkeep
!workspace/scenes/
!workspace/scenes/.gitkeep
!workspace/frames/
!workspace/frames/.gitkeep
!workspace/analysis/
!workspace/analysis/.gitkeep
!workspace/candidates/
!workspace/candidates/.gitkeep
!workspace/renders/
!workspace/renders/.gitkeep
!workspace/review/
!workspace/review/.gitkeep
!workspace/models/
!workspace/models/.gitkeep
!workspace/tmp/
!workspace/tmp/.gitkeep

# Never commit video, image, audio, or model artifacts
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.srt
*.vtt
*.ckpt
*.pt
*.pth
*.onnx
